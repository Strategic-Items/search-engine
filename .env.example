# Remote OpenSearch URL for the API and indexer. Local Compose uses port 9203.
OPENSEARCH_URL=http://localhost:9203
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
SEARCH_INDEX_ALIAS=search-documents
SEARCH_INDEX_PREFIX=search-documents-v
# Documents parsed from source files by unstructured-doc-parser. Separate
# index so rebuilding one corpus cannot drop the other.
SEARCH_DOCS_ALIAS=search-docs
SEARCH_DOCS_PREFIX=search-docs-v
# Past consultation cases. These are never read by the official knowledge/RAG path.
SEARCH_CALLCENTER_ALIAS=search-callcenter
SEARCH_CALLCENTER_PREFIX=search-callcenter-v
# docs-only also disables the external HSK linkage dataset.
SEARCH_DOCUMENT_DATASETS=core,docs
SEARCH_MODE=hybrid
SEARCH_HSK_ENABLED=true
SEARCH_HSK_ALIAS=search-hsk
SEARCH_HSK_PREFIX=search-hsk-v
# Local single-node cluster: 0. Set >=1 for a multi-node production cluster.
SEARCH_NUMBER_OF_REPLICAS=0
# Ollama runs on the host alongside the API. Pull OLLAMA_CHAT_MODEL before use.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Pull this once before vector indexing: ollama pull bge-m3
# Multilingual; an English-first model ranks this Korean corpus close to randomly.
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TEMPERATURE=0.4
# Covers prompt and answer together; Ollama truncates an over-long prompt silently,
# dropping the grounding rules at the front. Raise it alongside
# SEARCH_CHUNKS_PER_DOCUMENT: at 6 the longest docs v2 prompt is about 14,000
# tokens. Only CHAT_PROVIDER=ollama reads this; an OpenAI-compatible server sets
# its own window at startup (vLLM's --max-model-len).
OLLAMA_NUM_CTX=24576
OLLAMA_TIMEOUT_SECONDS=120
# Where the chat model runs: ollama (native API at OLLAMA_BASE_URL) or openai
# (OpenAI-compatible server -- vLLM, SGLang, llama.cpp, LM Studio). Embeddings
# always stay on Ollama: the index mapping fixes the vector width.
CHAT_PROVIDER=ollama
# Only for CHAT_PROVIDER=openai; both fall back to the OLLAMA_* values above.
# e.g. CHAT_BASE_URL_OVERRIDE=http://spark-23b2.local:8000/v1
#      CHAT_MODEL_OVERRIDE=qwen3-vl-30b-a3b
CHAT_BASE_URL_OVERRIDE=
CHAT_MODEL_OVERRIDE=
# Local servers ignore it, but the header must still be well-formed.
CHAT_API_KEY=none
# Must match OLLAMA_EMBEDDING_MODEL; changing either requires a full reindex.
SEARCH_EMBEDDING_DIMENSIONS=1024
SEARCH_VECTOR_CANDIDATES=50
SEARCH_HYBRID_RRF_K=60
# Chunks carried per returned document. Ranking still returns one document per
# slot; this decides how much of that document comes with it. 1 restores the
# previous single-chunk behaviour. At 6 the longest docs v2 prompt is about
# 14,000 tokens, so OLLAMA_NUM_CTX above must leave room for the answer too.
SEARCH_CHUNKS_PER_DOCUMENT=6
# Search a model-written rewrite of the query alongside the query itself and fuse
# the rankings. Off by default: small measured gain for ~0.5s per search, and it
# puts OLLAMA_CHAT_MODEL in the path of every search.
SEARCH_QUERY_REWRITE=false
# How much the rewrite's ranking counts against the original's (0 < w <= 1).
SEARCH_QUERY_REWRITE_WEIGHT=0.5
# Score each returned document's own chunks against the query and carry the best
# ones. Never changes which documents come back. Off by default, and measure
# before turning it on: a search costs ~90ms and this adds about 1.5s.
#
# Since stage 20 the chunks are already ordered by the dense retriever, which is
# most of what this buys. Against that, the cross-encoder gains 2.5p at rank 1
# and LOSES 1.3p by rank 6 on docs v2 -- and rank 6 is what the judge and the RAG
# prompt read, since both take every chunk of a document. Kept because the
# measurement narrowed stages 8 and 18, not because it earns its latency.
SEARCH_RERANK_CHUNKS=false
# An HTTP sidecar, like embeddings and chat. Any endpoint taking
# {model, query, documents} and returning one score per document works
# (text-embeddings-inference's /rerank, or your own wrapper).
SEARCH_RERANK_BASE_URL=http://localhost:8080
# The base model, NOT the Korean-tuned one. On this Korean corpus
# bge-reranker-v2-m3-ko was 9.0p worse at rank 1 and 0.7p better at rank 6 -- one
# requirement. Korean tuning helped the embedding (stage 13) and hurt the
# cross-encoder here; re-measure before swapping either.
SEARCH_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# How many of a document's candidates get scored; the rest keep their order. A
# ceiling on the worst case, not a latency knob -- a document carries 8
# candidates at the median, so this leaves p50 alone and cuts p95 by a quarter.
# It only bites because scoring now happens before the pool is cut; while it ran
# after the cut, no document ever reached six candidates and this did nothing.
SEARCH_RERANK_DEPTH=20
SEARCH_RERANK_TIMEOUT_SECONDS=30
# Ask the chat model whether the retrieved text actually answers the question,
# and return nothing when it says no. Off by default: it puts the chat model in
# the path of a search that has no model dependency otherwise, and adds ~2s.
#
# It is the only thing measured that separates an in-domain question the corpus
# cannot answer from one it can -- score floors and cross-encoder rerankers both
# rejected 0 of 8. The price is refusing answerable questions: 5.2% on docs v2,
# down from 14.8% before stage 20 put the evidence in front of it.
SEARCH_ANSWERABILITY_JUDGE=false
RAG_TOP_K=5
