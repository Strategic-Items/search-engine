# API와 인덱서에 사용할 원격 OpenSearch URL. 로컬 Compose는 포트 9203을 사용한다.
OPENSEARCH_URL=http://localhost:9203
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
SEARCH_INDEX_ALIAS=search-documents
SEARCH_INDEX_PREFIX=search-documents-v
# unstructured-doc-parser에 의해 소스 파일에서 파ース된 문서들. 별도의 인덱스로 관리하여 하나의 코퍼스를 재구성할 때 다른 코퍼스가 손실되지 않도록 함.
SEARCH_DOCS_ALIAS=search-docs
SEARCH_DOCS_PREFIX=search-docs-v
# 과거 상담 사례. 이들은 공식 지식/RAG 경로에서 읽히지 않는다.
SEARCH_CALLCENTER_ALIAS=search-callcenter
SEARCH_CALLCENTER_PREFIX=search-callcenter-v
# docs-only는 외부 HSK 연결 데이터셋도 비활성화한다.
SEARCH_DOCUMENT_DATASETS=core,docs
SEARCH_MODE=hybrid
SEARCH_HSK_ENABLED=true
SEARCH_HSK_ALIAS=search-hsk
SEARCH_HSK_PREFIX=search-hsk-v
# 로컬 단일 노드 클러스터: 다중 노드 프로덕션 클러스터를 위해 1 이상으로 설정한다.
SEARCH_NUMBER_OF_REPLICAS=0
# Ollama는 API와 함께 호스트에서 실행됩니다. 사용하기 전에 OLLAMA_CHAT_MODEL을 다운로드하십시오.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
# 벡터 인덱싱 전에 한 번 실행: ollama pull bge-m3
# 다국어 모델; 영어를 우선으로 하는 모델은 이 한국어 코퍼스를 거의 무작위로 순위 매긴다.
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TEMPERATURE=0.4
# 프롬프트와 답변을 함께 처리함; Ollama는 너무 긴 프롬프트를 조용히 잘라내며,
# 앞부분의 기반 규칙을 버림. SEARCH_CHUNKS_PER_DOCUMENT과 함께 올림.
# 6으로 설정하면 가장 긴 문서의 v2 프롬프트는 약 14,000 토큰임.
# CHAT_PROVIDER=ollama인 경우에만 이 설정을 읽음; OpenAI 호환 서버는 시작 시
# 자체적으로 창 크기를 설정함(vLLM의 --max-model-len).
OLLAMA_NUM_CTX=24576
OLLAMA_TIMEOUT_SECONDS=120
# 채팅 모델이 실행되는 위치: ollama (OLLAMA_BASE_URL의 네이티브 API) 또는 openai
# (OpenAI와 호환되는 서버 -- vLLM, SGLang, llama.cpp, LM Studio). 임베딩은 항상 ollama에 유지됨: 인덱스 매핑이 벡터 너비를 고정함.
CHAT_PROVIDER=ollama
# CHAT_PROVIDER가 openai인 경우에만 적용되며, 두 경우 모두 위의 OLLAMA_* 값으로 백업된다.
# 예: CHAT_BASE_URL_OVERRIDE=http://spark-23b2.local:8000/v1
#     CHAT_MODEL_OVERRIDE=qwen3-vl-30b-a3b
CHAT_BASE_URL_OVERRIDE=
CHAT_MODEL_OVERRIDE=
# 로컬 서버는 이를 무시하지만, 헤더는 여전히 올바르게 형성되어야 한다.
CHAT_API_KEY=none
# OLLAMA_EMBEDDING_MODEL과 일치해야 하며, 둘 중 하나를 변경하면 전체 재색인 필요
SEARCH_EMBEDDING_DIMENSIONS=1024
SEARCH_VECTOR_CANDIDATES=25
SEARCH_HYBRID_RRF_K=60
# 반환되는 문서당 포함되는 청크 수입니다. 순위 결정은 여전히 각 슬롯당 하나의 문서를 반환합니다. 이 설정은 그 문서에 얼마나 많은 청크가 포함될지를 결정합니다. 1은 이전의 단일 청크 동작을 복원합니다. 6으로 설정하면 가장 긴 문서의 v2 프롬프트는 약 14,000 토큰이 되므로, OLLAMA_NUM_CTX는 답변을 위한 공간도 남겨야 합니다.
SEARCH_CHUNKS_PER_DOCUMENT=6
# 쿼리 자체와 함께 모델이 작성한 쿼리 재작성 결과를 검색하고 랭킹을 융합한다.
# 기본적으로 비활성화되어 있다: 검색당 약 0.5초의 소량 성능 향상이 있으며,
# 모든 검색에서 OLLAMA_CHAT_MODEL이 경로에 포함된다.
SEARCH_QUERY_REWRITE=false
# 리라이트의 순위가 원본 순위에 대해 얼마나 영향을 미치는지 (0 < w <= 1)
SEARCH_QUERY_REWRITE_WEIGHT=0.5
# 반환된 문서의 각 청크를 쿼리와 비교하여 점수를 매기고 가장 좋은 청크를 유지한다.
# 문서 자체의 반환 여부는 변경하지 않는다. 기본적으로 비활성화되어 있으며, 활성화하기 전에 성능을 측정해야 한다: 검색에 약 90ms가 소요되며, 이 기능은 약 1.5초를 추가로 소요한다.
#
# 스테이지 20 이후 청크들은 이미 딥 리트리버에 의해 정렬되어 있으므로, 이 기능이 제공하는 이점은 그다지 크지 않다.
# 반면, 크로스엔코더는 문서 v2에서 랭크 1에서 2.5p의 성능 향상을 가져오지만, 랭크 6에서는 1.3p의 성능 저하를 초래한다.
# 랭크 6은 심사자와 RAG 프롬프트가 모두 문서의 모든 청크를 읽기 때문에 중요한 지표이다.
# 이 기능은 지연 시간을 감수하면서도 스테이지 8과 18의 측정 결과를 좁히기 때문에 유지되고 있으며,
# 지연 시간에 비해 성능 향상이 크지 않기 때문에 유지되는 것이 아니다.
SEARCH_RERANK_CHUNKS=false
# HTTP 사이드카로, 임베딩과 채팅과 같이 작동합니다.
# {model, query, documents}를 입력으로 받아 각 문서당 하나의 점수를 반환하는 모든 엔드포인트가 작동합니다.
# (text-embeddings-inference의 /rerank 또는 귀하의 워퍼)
SEARCH_RERANK_BASE_URL=http://localhost:8080
# 기본 모델, 한국어 튜닝되지 않은 모델. 이 한국어 코퍼스에서
# bge-reranker-v2-m3-ko는 랭크 1에서 9.0p worse, 랭크 6에서 0.7p better였음 -- 한 가지
# 요구사항. 한국어 튜닝은 임베딩(단계 13)에서는 도움이 되었지만
# 크로스엔코더에서는 악영향을 미쳤음; 모델을 교체하기 전에 다시 측정할 것.
SEARCH_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 문서의 후보 중 몇 개를 점수 매길지 결정한다. 나머지는 순서를 유지한다. 최악의 경우를 제한하는 값이며, 지연 시간 조절용이 아니다. 문서는 중앙값 기준으로 8개의 후보를 가지고 있으므로, 이 설정은 p50에는 영향을 주지 않고 p95를 4분의 1로 줄인다.
# 점수 매기기가 풀이 줄어들기 전에 수행되기 때문에 이 설정이 영향을 미친다. 이전에는 점수 매기기가 줄어든 후에 실행되었기 때문에 어떤 문서도 6개 이상의 후보를 가지지 않아 이 설정은 아무런 영향을 주지 않았다.
SEARCH_RERANK_DEPTH=20
SEARCH_RERANK_TIMEOUT_SECONDS=30
# 검색된 텍스트가 실제로 질문에 답변하는지 챗 모델에게 묻고,
# 답변하지 않는다고 하면 아무것도 반환하지 않는다. 기본적으로 비활성화되어 있다: 그렇지 않으면 검색 경로에 모델 의존성이 생기고 약 2초가 추가된다.
#
# 이 기능은 코퍼스가 답변할 수 없는 도메인 내 질문과 답변할 수 있는 질문을 구분하는 유일한 기준이다. 스코어 플로어와 크로스 캐리어 재정렬기 모두 8개의 질문 중 0개를 거절했다. 대가로 답변 가능한 질문을 거부하는 경우가 발생한다: docs v2 기준 5.2%로, stage 20에서 증거를 앞에 두기 전의 14.8%에서 감소했다.
SEARCH_ANSWERABILITY_JUDGE=false
RAG_TOP_K=5

# 30B 등 채팅 모델로 청크 관련도를 평가하고 무관(0점) 청크만 제거한다.
# 추가 LLM 호출이 발생한다. 조건/맥락(1점), 직접 근거(2점)는 유지한다.
SEARCH_CHUNK_FILTER=false

# 카테고리 검색(법령·고시, 행정·업무, 민원FAQ)의 어휘 검색기: 38단계에서 파인튜닝한 SPLADE.
# 가중치 폴더 경로를 지정하면 카테고리 색인(search-index --dataset law|admin)에 SPLADE 벡터를 싣고
# 카테고리 검색이 BM25 대신 SPLADE를 쓴다. 비워 두면 BM25다. pip install .[sparse]가 필요하다.
SEARCH_SPLADE_MODEL=
# 법령 카테고리 hybrid: 각 25개 후보와 명시 근거 일치 가산점.
SEARCH_LAW_CANDIDATES=25
SEARCH_LAW_REFERENCE_BOOST=6
