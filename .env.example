# Remote OpenSearch URL for the API and indexer. Local Compose uses port 9203.
OPENSEARCH_URL=http://localhost:9203
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
SEARCH_INDEX_ALIAS=search-documents
SEARCH_INDEX_PREFIX=search-documents-v
SEARCH_HSK_ALIAS=search-hsk
SEARCH_HSK_PREFIX=search-hsk-v
# Local single-node cluster: 0. Set >=1 for a multi-node production cluster.
SEARCH_NUMBER_OF_REPLICAS=0
# Ollama runs on the host alongside the API. Pull OLLAMA_CHAT_MODEL before use.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.4
OLLAMA_TIMEOUT_SECONDS=120
RAG_TOP_K=5
